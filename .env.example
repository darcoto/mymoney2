PORT=3456

# На кой адрес да слуша: 0.0.0.0 = всички интерфейси (по подразбиране),
# 127.0.0.1 = само локално (зад reverse proxy). Смяната изисква рестарт.
HOST=0.0.0.0

# Име на файла с базата данни (в папка ./data/).
# За демо база: DATABASE_NAME=demo.db
# Смяната изисква рестарт на сървъра.
DATABASE_NAME=finance.db

NODE_ENV=development
